# ==========================================================
# BookLoop Environment Variables Configuration Template
# ==========================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="BookLoop"

# Database Connections
# For local development with zero dependencies, SQLite works out of the box:
DATABASE_URL=sqlite:///./bookloop.db
# For PostgreSQL in Docker / Staging:
# DATABASE_URL=postgresql://bookloop_user:bookloop_secure_password_dev@localhost:5432/bookloop_db

# Security & Tokens
SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Pilot Launch City Configuration (Bidar, Karnataka)
LAUNCH_CITY=Bidar
LAUNCH_STATE=Karnataka
LAUNCH_PINCODES=["585401", "585402", "585403", "585404"]

# Marketplace Commercial Policies (CONFIGURABLE)
DEFAULT_COMMISSION_PERCENT=10.0
COMMISSION_GST_PERCENT=18.0
DEFAULT_INTRACITY_SHIPPING_FLAT_INR=40.0
DEFAULT_INTERCITY_SHIPPING_BASE_INR=70.0
SETTLEMENT_HOLD_DAYS=3

# Third-Party Logistics Adapters (Sandbox / Mock)
COURIER_PROVIDER=mock_courier
DELHIVERY_API_KEY=sandbox_token_here
DELHIVERY_CLIENT_ID=sandbox_client_here

# Payment Gateway Configuration (Sandbox / Mock)
PAYMENT_GATEWAY=mock_gateway
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=rzp_test_sample_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# Object Storage (S3 / MinIO for Book Photos)
S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
S3_BUCKET_NAME=bookloop-listing-photos
S3_ACCESS_KEY_ID=sample_access_key
S3_SECRET_ACCESS_KEY=sample_secret_key
